#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
ACTIVE_FILE="$REPO_DIR/test-runs/agent-vm-current"

if [[ ! -f $ACTIVE_FILE ]]; then
  printf 'No active agent VM recorded.\n'
  exit 0
fi

RUN_DIR="$(<"$ACTIVE_FILE")"
record_stop() { python3 - "$RUN_DIR/research-run.json" "$RUN_DIR/overlay.qcow2" "$1" <<'PYMETA'
import json,sys,datetime,os
p,overlay,result=sys.argv[1:]
try: d=json.load(open(p))
except Exception: d={}
d.update({"stopped_at_utc":datetime.datetime.now(datetime.timezone.utc).isoformat(),"vm_stop_state":result,"overlay_retained":os.path.exists(overlay),"overlay_path":overlay,"cleanup_result":d.get("cleanup_result","NOT_RECORDED")})
with open(p,'w') as f: json.dump(d,f,indent=2); f.write('\n')
os.chmod(p,0o600)
PYMETA
}
PIDFILE="$RUN_DIR/qemu.pid"
if [[ ! -f $PIDFILE ]]; then
  printf 'No QEMU pid file in %s\n' "$RUN_DIR" >&2
  exit 1
fi
PID="$(<"$PIDFILE")"
if ! kill -0 "$PID" 2>/dev/null; then
  printf 'VM is not running. Overlay retained at %s/overlay.qcow2\n' "$RUN_DIR"
  exit 0
fi

ssh -i "$REPO_DIR/test-runs/omarchy-4.0.4/id_ed25519" \
  -p "${OMARCHY_AGENT_SSH_PORT:-2222}" \
  -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null omarchy@127.0.0.1 \
  'echo omarchy | sudo -S systemctl poweroff' >/dev/null 2>&1 || true

for _ in {1..60}; do
  if ! kill -0 "$PID" 2>/dev/null; then
    record_stop 'CLEAN_SHUTDOWN'
    printf 'VM stopped. Overlay retained at %s/overlay.qcow2\n' "$RUN_DIR"
    exit 0
  fi
  sleep 1
done

kill -TERM "$PID" 2>/dev/null || true
record_stop 'TERM_AFTER_TIMEOUT'
printf 'VM stopped after timeout. Overlay retained at %s/overlay.qcow2\n' "$RUN_DIR"
